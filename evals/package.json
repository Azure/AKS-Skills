{
  "name": "aks-skills-evals",
  "version": "1.0.0",
  "private": true,
  "description": "Evaluation pipeline for AKS Skills",
  "scripts": {
    "lint": "node lint-skills.js",
    "eval": "promptfoo eval -o results.json",
    "eval:trigger": "promptfoo eval -c promptfoo-routing.yaml -o routing-results.json",
    "eval:baseline": "promptfoo eval -c promptfoo-baseline.yaml -o baseline-results.json",
    "eval:all": "npm run eval && npm run eval:trigger",
    "eval:view": "promptfoo view"
  },
  "dependencies": {
    "promptfoo": "^0.121.13"
  }
}