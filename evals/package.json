{
  "name": "aks-skills-evals",
  "version": "1.0.0",
  "private": true,
  "description": "Evaluation pipeline for AKS Skills",
  "scripts": {
    "lint": "node lint-skills.js",
    "lint:selftest": "node lint-skills.test.js",
    "eval": "promptfoo eval -o results.json",
    "eval:trigger": "promptfoo eval -c promptfoo-routing.yaml -o routing-results.json",
    "eval:baseline": "promptfoo eval -c promptfoo-baseline.yaml -o baseline-results.json",
    "eval:all": "npm run eval; npm run eval:trigger",
    "eval:view": "promptfoo view",
    "lint:agentic": "vally lint --eval-spec tests",
    "eval:agentic": "vally eval --workers 2",
    "eval:mock": "PATH=\"$PWD/mocks/bin:$PATH\" vally eval --tag tier=mock",
    "report": "node scripts/generate-report.mjs"
  },
  "devDependencies": {
    "@microsoft/vally": "^0.6.0",
    "@microsoft/vally-cli": "^0.6.0",
    "js-yaml": "^4.2.0",
    "promptfoo": "^0.121.19"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
